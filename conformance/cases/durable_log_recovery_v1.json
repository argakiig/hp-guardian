{
  "format_version": 1,
  "tail_recovery": [
    {
      "name": "torn active tail retains its valid prefix",
      "files": {
        "active": {"utf8": "{\"event\":\"activation\"}\n{\"event\":\"authorization\"}\n{\"partial"}
      },
      "expect": {
        "error": null,
        "active_prefix": "{\"event\":\"activation\"}\n{\"event\":\"authorization\"}\n",
        "recovered_tail": true
      }
    },
    {
      "name": "torn backup tail retains its valid prefix",
      "files": {
        "backup_1": {"utf8": "{\"event\":\"authorization\"}\n{\"partial"}
      },
      "expect": {
        "error": null,
        "backup_prefixes": {"backup_1": "{\"event\":\"authorization\"}\n"},
        "recovered_tail": true
      }
    },
    {
      "name": "malformed complete line blocks without mutation",
      "files": {
        "active": {"utf8": "{\"event\":\"activation\"}\n{bad json\n"}
      },
      "expect": {"error": "audit_corrupt", "unchanged": true}
    },
    {
      "name": "invalid utf8 blocks without mutation",
      "files": {
        "active": {"hex": "7b226576656e74223a2261637469766174696f6e227d0afffe"}
      },
      "expect": {"error": "audit_corrupt", "unchanged": true}
    },
    {
      "name": "empty complete line blocks without mutation",
      "files": {
        "active": {"utf8": "{\"event\":\"activation\"}\n\n"}
      },
      "expect": {"error": "audit_corrupt", "unchanged": true}
    },
    {
      "name": "parseable unterminated object blocks without mutation",
      "files": {
        "active": {"utf8": "{\"event\":\"activation\"}\n{\"event\":\"authorization\"}"}
      },
      "expect": {"error": "audit_corrupt", "unchanged": true}
    }
  ],
  "rotation_recovery": [
    {
      "name": "manifest before staging completes the rotation",
      "manifest": {"format_version": 1, "transaction_id": "txn-before", "max_rotated_files": 3, "operation": "rotate", "phase": "staging", "present": {"active": true, "backups": [1, 2, 3]}},
      "files": {
        "active": {"utf8": "{\"event\":\"active\"}\n"},
        "backup_1": {"utf8": "{\"event\":\"backup-1\"}\n"},
        "backup_2": {"utf8": "{\"event\":\"backup-2\"}\n"},
        "backup_3": {"utf8": "{\"event\":\"backup-3\"}\n"}
      },
      "expect": {
        "error": null,
        "manifest_absent": true,
        "staging_absent": true,
        "backups": {
          "backup_1": "{\"event\":\"active\"}\n",
          "backup_2": "{\"event\":\"backup-1\"}\n",
          "backup_3": "{\"event\":\"backup-2\"}\n"
        }
      }
    },
    {
      "name": "manifest during staging completes the rotation",
      "manifest": {"format_version": 1, "transaction_id": "txn-staged", "max_rotated_files": 2, "operation": "rotate", "phase": "installing", "present": {"active": true, "backups": [1, 2]}},
      "files": {
        "stage_active": {"utf8": "{\"event\":\"active\"}\n"},
        "stage_backup_1": {"utf8": "{\"event\":\"backup-1\"}\n"},
        "stage_backup_2": {"utf8": "{\"event\":\"backup-2\"}\n"}
      },
      "expect": {
        "error": null,
        "manifest_absent": true,
        "staging_absent": true,
        "backups": {
          "backup_1": "{\"event\":\"active\"}\n",
          "backup_2": "{\"event\":\"backup-1\"}\n"
        }
      }
    },
    {
      "name": "manifest after installation removes only remaining staging",
      "manifest": {"format_version": 1, "transaction_id": "txn-installed", "max_rotated_files": 2, "operation": "rotate", "phase": "installing", "present": {"active": true, "backups": [1, 2]}},
      "files": {
        "backup_1": {"utf8": "{\"event\":\"active\"}\n"},
        "backup_2": {"utf8": "{\"event\":\"backup-1\"}\n"},
        "stage_backup_2": {"utf8": "{\"event\":\"backup-2\"}\n"}
      },
      "expect": {
        "error": null,
        "manifest_absent": true,
        "staging_absent": true,
        "backups": {
          "backup_1": "{\"event\":\"active\"}\n",
          "backup_2": "{\"event\":\"backup-1\"}\n"
        }
      }
    },
    {
      "name": "incompatible manifest blocks without mutation",
      "manifest": {"format_version": 2, "transaction_id": "txn-invalid", "max_rotated_files": 2, "operation": "rotate", "phase": "staging", "present": {"active": true, "backups": []}},
      "files": {"active": {"utf8": "{\"event\":\"active\"}\n"}},
      "expect": {"error": "audit_recovery_failed", "unchanged": true}
    },
    {
      "name": "staging without manifest blocks without mutation",
      "files": {"stage_active": {"utf8": "{\"event\":\"orphan\"}\n"}},
      "expect": {"error": "audit_recovery_failed", "unchanged": true}
    }
  ],
  "lock_contention": {"expected_error": "audit_lock_unavailable"}
}
